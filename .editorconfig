root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ktlint_function_naming_ignore_when_annotated_with = Composable
# Jetpack Compose's own API guidelines recommend wildcard imports for these
# packages: https://github.com/androidx/androidx/blob/androidx-main/compose/docs/compose-api-guidelines.md#compose-mode
ij_kotlin_packages_to_use_import_on_demand = androidx.compose.foundation.layout.*,androidx.compose.material3.*,androidx.compose.runtime.*

[*.{yml,yaml,json}]
indent_size = 2
