rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    function deckDoc(deckId) {
      return get(/databases/$(database)/documents/decks/$(deckId)).data;
    }

    // Only the API can issue grants. The request ID binds a grant to one friendship
    // so unfriend -> refriend does not silently restore an old share.
    function hasActiveShare(deckId, deck) {
      let share = get(/databases/$(database)/documents/decks/$(deckId)/shares/$(request.auth.uid)).data;
      let friendship = get(/databases/$(database)/documents/social_backends/$(share.namespace)/relationships/$(share.pair_id)).data;
      return share.owner_id == deck.ownerId
        && friendship.status == 'accepted'
        && friendship.id == share.relationship_id
        && share.owner_hash != share.recipient_hash
        && friendship.members.hasAll([share.owner_hash, share.recipient_hash]);
    }

    function canReadDeck(deckId, deck) {
      return isSignedIn() &&
        (deck.ownerId == request.auth.uid || deck.visibility == 'public'
          || hasActiveShare(deckId, deck));
    }

    // Authenticated API requests use the Admin SDK; mobile/web clients cannot
    // edit friendships, identity mappings, or issue their own share grants.
    match /social_backends/{namespace}/{document=**} {
      allow read, write: if false;
    }

    // Cloud deck catalogue. Per-user study progress (SM-2 / FSRS) stays on-device.
    match /decks/{deckId} {
      allow read: if resource != null && canReadDeck(deckId, resource.data);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && !request.resource.data.keys().hasAny(['copiedFrom'])
        && request.resource.data.visibility in ['private', 'public']
        && request.resource.data.keys().hasAll([
          'name', 'ownerId', 'visibility', 'updatedAt', 'cardCount'
        ]);

      allow update: if isOwner(resource.data.ownerId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.get('copiedFrom', null) == resource.data.get('copiedFrom', null)
        && request.resource.data.visibility in ['private', 'public'];

      allow delete: if isOwner(resource.data.ownerId);

      match /cards/{cardId} {
        allow read: if canReadDeck(deckId, deckDoc(deckId));

        allow create, update: if isSignedIn()
          && isOwner(deckDoc(deckId).ownerId)
          && request.resource.data.keys().hasAll([
            'front', 'back', 'position'
          ]);

        allow delete: if isSignedIn() && isOwner(deckDoc(deckId).ownerId);
      }

      match /shares/{recipientUid} {
        allow read, write: if false;
      }
    }
  }
}
