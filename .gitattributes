# Normalize line endings for all text files to LF in the repository,
# regardless of what a contributor's local core.autocrlf is set to.
* text=auto eol=lf

# Windows batch files need CRLF to be reliably run by cmd.exe.
*.bat text eol=crlf

# Never let git touch line endings in binaries.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
